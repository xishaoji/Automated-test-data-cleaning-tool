# ---- LLM provider ----
# Works for any OpenAI-compatible endpoint (DeepSeek / Qwen / Together / ...).
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0

# ---- Sandbox ----
SANDBOX_IMAGE=pandas-sandbox:latest
SANDBOX_MEMORY=256m
SANDBOX_CPU_QUOTA=50000        # 50% of one CPU (period=100000)
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=30

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false                 # set to true to emit structured JSON logs

# ---- Safety ----
MAX_UPLOAD_MB=50
MAX_ERROR_RETRIES=3
